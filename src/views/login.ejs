<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Travel Login</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        *{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body{

            height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;

            overflow: hidden;

            background:
                    linear-gradient(
                            rgba(0,0,0,0.35),
                            rgba(0,0,0,0.35)
                    ),
                    url("https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=2070");

            background-size: cover;
            background-position: center;
        }

        .login-box{

            width: 420px;

            padding: 45px;

            border-radius: 30px;

            backdrop-filter: blur(15px);

            background: rgba(255,255,255,0.12);

            border: 1px solid rgba(255,255,255,0.2);

            box-shadow:
                    0 10px 40px rgba(0,0,0,0.3);

            color: white;
        }

        .logo{

            text-align: center;

            margin-bottom: 10px;

            font-size: 40px;
        }

        .login-box h2{

            text-align: center;

            font-size: 32px;

            margin-bottom: 10px;

            font-weight: 700;
        }

        .sub-title{

            text-align: center;

            margin-bottom: 35px;

            font-size: 14px;

            color: rgba(255,255,255,0.8);
        }

        .input-group{

            margin-bottom: 22px;
        }

        .input-group label{

            display: block;

            margin-bottom: 8px;

            font-size: 14px;

            font-weight: 500;
        }

        .input-group input{

            width: 100%;

            padding: 14px 16px;

            border-radius: 15px;

            border: 1px solid rgba(255,255,255,0.25);

            background: rgba(255,255,255,0.15);

            color: white;

            outline: none;

            transition: 0.3s;
        }

        .input-group input::placeholder{

            color: rgba(255,255,255,0.7);
        }

        .input-group input:focus{

            border-color: #fff;

            background: rgba(255,255,255,0.2);

            box-shadow:
                    0 0 15px rgba(255,255,255,0.3);
        }

        .error{

            color: #ffd4d4;

            margin-top: 6px;

            font-size: 13px;
        }

        .remember{

            display: flex;
            justify-content: space-between;
            align-items: center;

            margin-bottom: 25px;

            font-size: 14px;
        }

        .remember a{

            color: white;

            text-decoration: none;
        }

        .remember a:hover{

            text-decoration: underline;
        }

        .login-btn{

            width: 100%;

            padding: 15px;

            border: none;

            border-radius: 16px;

            background:
                    linear-gradient(
                            135deg,
                            #ff9966,
                            #ff5e62
                    );

            color: white;

            font-size: 16px;

            font-weight: 600;

            cursor: pointer;

            transition: 0.3s;
        }

        .login-btn:hover{

            transform: translateY(-3px);

            box-shadow:
                    0 10px 20px rgba(255,94,98,0.4);
        }

        .bottom-text{

            margin-top: 25px;

            text-align: center;

            font-size: 14px;

            color: rgba(255,255,255,0.85);
        }

        .bottom-text a{

            color: #fff;

            text-decoration: none;

            font-weight: 600;
        }

        .bottom-text a:hover{

            text-decoration: underline;
        }

        .floating{

            position: absolute;

            border-radius: 50%;

            background: rgba(255,255,255,0.08);

            animation: float 8s infinite ease-in-out;
        }

        .floating:nth-child(1){

            width: 180px;
            height: 180px;

            top: 10%;
            left: 8%;
        }

        .floating:nth-child(2){

            width: 250px;
            height: 250px;

            bottom: -50px;
            right: -50px;
        }

        @keyframes float {

            0%{
                transform: translateY(0px);
            }

            50%{
                transform: translateY(-20px);
            }

            100%{
                transform: translateY(0px);
            }
        }

    </style>

</head>

<body>

<div class="floating"></div>

<div class="floating"></div>

<div class="login-box">

    <div class="logo">
        ✈️
    </div>

    <h2>Travel Tour</h2>

    <p class="sub-title">
        Khám phá thế giới cùng chúng tôi
    </p>

    <form id="loginForm"
          action="/login"
          method="POST">

        <div class="input-group">

            <label>Email</label>

            <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Nhập email..."
            >

            <div class="error"
                 id="emailError"></div>

        </div>

        <div class="input-group">

            <label>Password</label>

            <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Nhập mật khẩu..."
            >

            <div class="error"
                 id="passwordError"></div>

        </div>

        <div class="remember">

            <label>
                <input type="checkbox">
                Ghi nhớ đăng nhập
            </label>

            <a href="#">
                Quên mật khẩu?
            </a>

        </div>

        <button type="submit"
                class="login-btn">

            Đăng nhập

        </button>

    </form>

    <div class="bottom-text">

        Chưa có tài khoản?

        <a href="/register">
            Đăng ký ngay
        </a>

    </div>

</div>

<script>

    const form =
        document.getElementById("loginForm");

    form.addEventListener("submit", function(event){

        let isValid = true;

        const email =
            document.getElementById("email")
                .value.trim();

        const password =
            document.getElementById("password")
                .value.trim();

        const emailError =
            document.getElementById("emailError");

        const passwordError =
            document.getElementById("passwordError");

        emailError.innerText = "";
        passwordError.innerText = "";

        if(email === ""){

            emailError.innerText =
                "Email không được để trống";

            isValid = false;
        }
        else{

            const emailRegex =
                /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

            if(!emailRegex.test(email)){

                emailError.innerText =
                    "Email không đúng định dạng";

                isValid = false;
            }
        }

        if(password === ""){

            passwordError.innerText =
                "Mật khẩu không được để trống";

            isValid = false;
        }
        else if(password.length < 6){

            passwordError.innerText =
                "Mật khẩu phải >= 6 ký tự";

            isValid = false;
        }

        if(!isValid){

            event.preventDefault();
        }

    });

</script>

</body>

</html>