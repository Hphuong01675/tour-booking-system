<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Đăng ký - TravelSync</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-tertiary-fixed": "#001e2b",
                        "on-secondary": "#ffffff",
                        "primary-fixed": "#dde1ff",
                        "tertiary-fixed": "#c2e8ff",
                        "tertiary": "#005471",
                        "on-primary": "#ffffff",
                        "secondary": "#a04100",
                        "surface-variant": "#e2e2e5",
                        "on-surface": "#1a1c1e",
                        "on-secondary-fixed": "#351000",
                        "surface-container-highest": "#e2e2e5",
                        "on-error": "#ffffff",
                        "on-tertiary": "#ffffff",
                        "secondary-fixed-dim": "#ffb693",
                        "error": "#ba1a1a",
                        "on-primary-fixed": "#001452",
                        "surface-bright": "#f9f9fc",
                        "on-secondary-fixed-variant": "#7a3000",
                        "primary-fixed-dim": "#b7c4ff",
                        "error-container": "#ffdad6",
                        "surface": "#f9f9fc",
                        "surface-container-low": "#f3f3f6",
                        "outline-variant": "#c3c5d9",
                        "inverse-on-surface": "#f0f0f3",
                        "outline": "#737688",
                        "background": "#f9f9fc",
                        "inverse-primary": "#b7c4ff",
                        "secondary-fixed": "#ffdbcc",
                        "secondary-container": "#fe6b00",
                        "on-error-container": "#93000a",
                        "tertiary-fixed-dim": "#75d1ff",
                        "tertiary-container": "#006e92",
                        "on-tertiary-container": "#c6eaff",
                        "on-primary-container": "#dfe3ff",
                        "on-secondary-container": "#572000",
                        "surface-container-high": "#e8e8ea",
                        "surface-container-lowest": "#ffffff",
                        "on-primary-fixed-variant": "#0038b6",
                        "on-background": "#1a1c1e",
                        "primary-container": "#0052ff",
                        "surface-dim": "#dadadc",
                        "surface-tint": "#004ced",
                        "on-tertiary-fixed-variant": "#004d67",
                        "on-surface-variant": "#434656",
                        "primary": "#003ec7",
                        "surface-container": "#eeeef0",
                        "inverse-surface": "#2f3133"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "container-max": "1280px",
                        "base": "8px",
                        "gutter": "24px",
                        "margin": "40px"
                    },
                    "fontFamily": {
                        "h3": ["Plus Jakarta Sans"],
                        "label-sm": ["Inter"],
                        "body-md": ["Inter"],
                        "h2": ["Plus Jakarta Sans"],
                        "h1": ["Plus Jakarta Sans"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "h3": ["24px", { "lineHeight": "1.4", "fontWeight": "700" }],
                        "label-sm": ["12px", { "lineHeight": "1.2", "letterSpacing": "0.05em", "fontWeight": "600" }],
                        "body-md": ["16px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "h2": ["32px", { "lineHeight": "1.3", "fontWeight": "700" }],
                        "h1": ["48px", { "lineHeight": "1.2", "fontWeight": "800" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }]
                    }
                },
            },
        }
    </script>
    <style>
        .glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-background font-body-md text-on-surface">
    <main class="min-h-screen flex items-stretch overflow-hidden">
        <!-- Left Side: Inspirational Image Panel -->
        <section class="hidden lg:flex lg:w-1/2 relative overflow-hidden items-center justify-center">
            <div class="absolute inset-0 z-0">
                <img class="w-full h-full object-cover" data-alt="A breathtaking view of a turquoise tropical bay surrounded by lush green limestone cliffs in Southeast Asia. The sun is shining brightly, casting a sparkling glow over the crystal-clear water where small wooden boats are gently drifting. The scene is vibrant and high-saturation, evoking a sense of luxury and adventure. The lighting is soft and golden, perfectly aligning with the clean, modern light-mode aesthetic of the TravelSync platform." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCYBFv3eyQwcrXKQK6D70qQ0xLoqSJKQo7GT7j2imyElEDFkq9ClLhf26ABlZXuBigT9MiFi1_uFhDuBwFzSw25iaR8Ceo2uOTZDeVDN57HopNqchkaWe8Lm1T4ew68V5g9umhLArmPiGHQBTWhHJ9pYAH200X2Kt_6erHyJz7A8ycGUxH9POboDN3IU2ELWeLtmF-EqEy-r5j92ed-VCvaXUvOApxpLvsqzJ516A5K2yP5uTzmYtkRBhHBpWw_3GzZbZ9PMp662Q" />
                <div class="absolute inset-0 bg-gradient-to-br from-primary/30 to-on-tertiary-fixed/60"></div>
            </div>
            <div class="relative z-10 p-margin text-white max-w-lg">
                <h1 class="font-h1 text-h1 mb-6 text-white">Khám phá thế giới cùng TravelSync</h1>
                <p class="font-body-lg text-body-lg text-white/90 leading-relaxed mb-8">
                    Quản lý hành trình chuyên nghiệp, kết nối tour du lịch và mang lại những trải nghiệm khó quên cho khách hàng của bạn.
                </p>
                <div class="flex items-center gap-4 bg-white/10 backdrop-blur-md p-4 rounded-xl border border-white/20">
                    <div class="w-12 h-12 rounded-full bg-secondary flex items-center justify-center">
                        <span class="material-symbols-outlined text-white">explore</span>
                    </div>
                    <div>
                        <p class="font-label-sm text-label-sm uppercase tracking-wider text-white/70">Cộng đồng của chúng tôi</p>
                        <p class="font-h3 text-h3 text-white">+500 Tour Operators</p>
                    </div>
                </div>
            </div>
        </section>
        <!-- Right Side: Sign Up Form -->
        <section class="w-full lg:w-1/2 bg-surface flex flex-col items-center justify-center p-6 md:p-margin relative overflow-y-auto">
            <!-- Logo Mobile/Top -->
            <div class="absolute top-8 left-8 lg:left-margin">
                <span class="font-h3 text-h3 font-bold text-primary">TravelSync</span>
            </div>
            <div class="w-full max-w-[480px] bg-surface-container-lowest p-8 md:p-12 rounded-2xl shadow-sm border border-outline-variant">
                <div class="mb-8">
                    <h2 class="font-h2 text-h2 mb-2">Đăng ký tài khoản</h2>
                    <p class="font-body-md text-on-surface-variant">Bắt đầu quản lý tour chuyên nghiệp ngay hôm nay.</p>
                </div>
                <form id="registerForm" class="space-y-5">
                    <!-- First Name -->
                    <div class="space-y-2">
                        <label class="font-label-sm text-label-sm text-on-surface-variant block">Họ</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">person</span>
                            <input name="firstName" class="w-full pl-10 pr-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary-container/20 transition-all outline-none" placeholder="Nguyễn" type="text" required minlength="2" maxlength="50" pattern="^[a-zA-ZÀ-ỹ\s]+$" title="Họ chỉ được chứa chữ cái và khoảng trắng, từ 2-50 ký tự" />
                        </div>
                    </div>
                    <!-- Last Name -->
                    <div class="space-y-2">
                        <label class="font-label-sm text-label-sm text-on-surface-variant block">Tên</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">person</span>
                            <input name="lastName" class="w-full pl-10 pr-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary-container/20 transition-all outline-none" placeholder="Văn A" type="text" required minlength="2" maxlength="50" pattern="^[a-zA-ZÀ-ỹ\s]+$" title="Tên chỉ được chứa chữ cái và khoảng trắng, từ 2-50 ký tự" />
                        </div>
                    </div>
                    <!-- Email -->
                    <div class="space-y-2">
                        <label class="font-label-sm text-label-sm text-on-surface-variant block">Email</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">mail</span>
                            <input name="email" class="w-full pl-10 pr-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary-container/20 transition-all outline-none" placeholder="example@travelsync.com" type="email" required />
                        </div>
                    </div>
                    <!-- Phone -->
                    <div class="space-y-2">
                        <label class="font-label-sm text-label-sm text-on-surface-variant block">Số điện thoại</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">call</span>
                            <input name="phoneNumber" class="w-full pl-10 pr-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary-container/20 transition-all outline-none" placeholder="0901234567" type="tel" pattern="^(0[3|5|7|8|9])+([0-9]{8})$" title="Số điện thoại phải đúng định dạng Việt Nam (VD: 0901234567)" />
                        </div>
                    </div>
                    <!-- Address -->
                    <div class="space-y-2">
                        <label class="font-label-sm text-label-sm text-on-surface-variant block">Địa chỉ</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">location_on</span>
                            <input name="address" class="w-full pl-10 pr-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary-container/20 transition-all outline-none" placeholder="123 Đường ABC, Quận XYZ" type="text" maxlength="255" />
                        </div>
                    </div>
                    <!-- Gender -->
                    <div class="space-y-2">
                        <label class="font-label-sm text-label-sm text-on-surface-variant block">Giới tính</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">wc</span>
                            <select name="gender" class="w-full pl-10 pr-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary-container/20 transition-all outline-none">
                                <option value="">Chọn giới tính (tùy chọn)</option>
                                <option value="true">Nam</option>
                                <option value="false">Nữ</option>
                            </select>
                        </div>
                    </div>
                    <!-- Password -->
                    <div class="space-y-2">
                        <label class="font-label-sm text-label-sm text-on-surface-variant block">Mật khẩu</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">lock</span>

                            <input name="password" id="password"
                                class="w-full pl-10 pr-10 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary-container/20 transition-all outline-none"
                                placeholder="••••••••"
                                type="password"
                                required
                                minlength="8"
                                pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]+$"
                                title="Mật khẩu phải từ 8 ký tự, chứa ít nhất 1 chữ hoa, 1 chữ thường, 1 số và 1 ký tự đặc biệt" />

                            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline cursor-pointer hover:text-primary transition-colors" onclick="togglePassword()">visibility</span>
                        </div>
                    </div>
                    <!-- Confirm Password -->
                    <div class="space-y-2">
                        <label class="font-label-sm text-label-sm text-on-surface-variant block">Xác nhận mật khẩu</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">lock_reset</span>
                            <input name="confirmPassword" id="confirmPassword" class="w-full pl-10 pr-4 py-3 bg-surface rounded-lg border border-outline-variant focus:border-primary focus:ring-4 focus:ring-primary-container/20 transition-all outline-none" placeholder="••••••••" type="password" required />
                        </div>
                    </div>
                    <!-- Submit Button -->
                    <button id="submitBtn" class="w-full py-4 bg-secondary-container hover:bg-secondary text-white font-bold rounded-xl shadow-[0_4px_0_0_rgba(160,65,0,1)] active:shadow-none active:translate-y-1 transition-all flex items-center justify-center gap-2 mt-4" type="submit">
                        <span>Đăng ký ngay</span>
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                </form>
                <div id="message" class="mt-4 text-center hidden"></div>
                <div class="mt-8 text-center">
                    <p class="font-body-md text-on-surface-variant">
                        Đã có tài khoản?
                        <a class="text-primary font-bold hover:underline ml-1" href="/login">Đăng nhập ngay</a>
                    </p>
                </div>
                <!-- Social Sign Up -->
                <div class="mt-10">
                    <div class="relative flex items-center justify-center mb-6">
                        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-outline-variant"></div></div>
                        <span class="relative px-4 bg-surface-container-lowest text-on-surface-variant font-label-sm text-label-sm uppercase">Hoặc đăng ký bằng</span>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <button class="flex items-center justify-center gap-2 py-3 px-4 rounded-xl border border-outline-variant hover:bg-surface transition-all active:scale-95">
                            <svg class="w-5 h-5" viewbox="0 0 24 24">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"></path>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
                            </svg>
                            <span class="font-label-sm text-label-sm">Google</span>
                        </button>
                        <button class="flex items-center justify-center gap-2 py-3 px-4 rounded-xl border border-outline-variant hover:bg-surface transition-all active:scale-95">
                            <svg class="w-5 h-5" fill="#1877F2" viewbox="0 0 24 24">
                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
                            </svg>
                            <span class="font-label-sm text-label-sm">Facebook</span>
                        </button>
                    </div>
                </div>
            </div>
            <!-- Footer Small -->
            <div class="mt-8 text-center px-margin max-w-lg">
                <p class="font-label-sm text-label-sm text-outline">
                    © 2024 TravelSync Management. Bảo mật • Điều khoản • Trợ giúp
                </p>
            </div>
        </section>
    </main>
    <script>
        function togglePassword() {
            const password = document.getElementById('password');
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);
        }

        document.getElementById('registerForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const submitBtn = document.getElementById('submitBtn');
            const messageDiv = document.getElementById('message');
            const formData = new FormData(this);
            const data = Object.fromEntries(formData);

            // Check if passwords match
            if (data.password !== data.confirmPassword) {
                messageDiv.className = 'mt-4 text-center text-error';
                messageDiv.textContent = 'Mật khẩu xác nhận không khớp.';
                messageDiv.classList.remove('hidden');
                return;
            }

            // Convert gender to boolean
            if (data.gender === "true") {
                data.gender = true;
            } else if (data.gender === "false") {
                data.gender = false;
            } else {
                delete data.gender;
            }

            // Remove confirmPassword from data
            delete data.confirmPassword;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span>Đang xử lý...</span>';

            try {
                const response = await fetch('/api/auth/register', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data),
                });

                const result = await response.json();

                if (response.ok) {
                    messageDiv.className = 'mt-4 text-center text-secondary';
                    messageDiv.textContent = result.message + ' Vui lòng kiểm tra email để nhập mã OTP kích hoạt.';
                    messageDiv.classList.remove('hidden');
                    // Optionally redirect to OTP page
                    setTimeout(() => {
                        window.location.href = '/verify-activation-otp?email=' + encodeURIComponent(data.email);
                    }, 3000);
                } else {
                    messageDiv.className = 'mt-4 text-center text-error';
                    messageDiv.textContent = result.message;
                    messageDiv.classList.remove('hidden');
                }
            } catch (error) {
                messageDiv.className = 'mt-4 text-center text-error';
                messageDiv.textContent = 'Lỗi kết nối. Vui lòng thử lại.';
                messageDiv.classList.remove('hidden');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<span>Đăng ký ngay</span><span class="material-symbols-outlined">arrow_forward</span>';
            }
        });
    </script>
</body>
</html>
